{
  "name": "@toxicwind/strudel-voices",
  "version": "0.1.0",
  "description": "Voice/filter pattern functions + WebSocket bridge for Strudel \u2014 wavetable, filterCutoff/filterRes, unison, detune.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "strudel",
    "tidalcycles",
    "livecoding",
    "voice",
    "synthesizer",
    "algorave",
    "pattern"
  ],
  "dependencies": {
    "@strudel/core": "^1.2.0",
    "@strudel/web": "^1.2.0",
    "@strudel/webaudio": "^1.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "bun-types": "^1.4.4",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.0.0"
  }
}